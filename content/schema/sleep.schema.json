{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sleep.schema.json",
  "title": "Sleep adhkar content pack",
  "description": "The «أذكار النوم» page: what is read and said at bedtime and at night, each with its source. Each item has exactly one of quran, sura, text or steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "version", "items"],
  "properties": {
    "pack": { "const": "sleep" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^sleep-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1, "description": "A heading above the item." },
          "prefix": { "type": "string", "minLength": 1, "description": "What is done or said before the text." },
          "quran": {
            "type": "array",
            "minItems": 1,
            "description": "Quran passages read in turn.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["edition", "surah", "ayahFrom", "ayahTo", "basmala", "text", "citation"],
              "properties": {
                "edition": { "const": "alquran-cloud:quran-uthmani" },
                "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
                "ayahFrom": { "type": "integer", "minimum": 1 },
                "ayahTo": { "type": "integer", "minimum": 1 },
                "basmala": { "type": "boolean", "description": "Whether the passage opens with the basmala, as a whole sura does." },
                "text": { "type": "string", "minLength": 1, "description": "Uthmani text closed by ayah markers ﴿n﴾, as in the adhkar pack." },
                "citation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sura": { "type": "string", "pattern": "^[a-z]+$", "description": "A whole sura read from the suwar pack, by its id." },
          "text": { "type": "string", "minLength": 1, "description": "The dhikr, in the wording of `hadith` when it names one." },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "hadith": { "type": "string", "pattern": "^[a-z]+:[0-9]+$", "description": "The hadith whose wording `text` is, in reference/hadith.sleep.json." },
          "count": { "type": "integer", "minimum": 2 },
          "countLabel": { "type": "string", "minLength": 1 },
          "note": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "hadith": { "type": "string", "pattern": "^[a-z]+:[0-9]+$", "description": "The hadith the «…» quotation in the text comes from, in reference/hadith.sleep.json." }
            }
          }
        }
      }
    }
  }
}

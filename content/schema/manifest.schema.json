{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packs"
  ],
  "properties": {
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adhkar",
        "ruqyah"
      ],
      "properties": {
        "adhkar": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "version",
            "sha256",
            "reviewRecord"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reviewRecord": {
              "type": "string",
              "pattern": "^R[0-9]+$"
            }
          }
        },
        "ruqyah": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "version",
            "sha256",
            "reviewRecord"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reviewRecord": {
              "type": "string",
              "pattern": "^R[0-9]+$"
            }
          }
        }
      }
    }
  }
}

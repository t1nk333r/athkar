{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope-v1.schema.json",
  "title": "athkar-backup format 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "app",
        "exportedAt",
        "timeZone"
      ],
      "properties": {
        "format": {
          "const": 1
        },
        "app": {
          "enum": [
            "athkar-pwa",
            "ruqyah-pwa"
          ]
        },
        "exportedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adhkar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "today",
        "history"
      ],
      "properties": {
        "today": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "progress",
            "targets",
            "completedAt",
            "manualCompletion"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "progress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "morning",
                "evening"
              ],
              "properties": {
                "morning": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "evening": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "morning",
                "evening"
              ],
              "properties": {
                "morning": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "evening": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "completedAt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "morning",
                "evening"
              ],
              "properties": {
                "morning": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                },
                "evening": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                }
              }
            },
            "manualCompletion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "morning",
                "evening"
              ],
              "properties": {
                "morning": {
                  "type": "boolean"
                },
                "evening": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "history": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "morning",
              "evening",
              "morningAt",
              "eveningAt"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "morning": {
                "type": "boolean"
              },
              "evening": {
                "type": "boolean"
              },
              "morningAt": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
              },
              "eveningAt": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
              }
            }
          }
        }
      }
    },
    "ruqyah": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "today",
        "history"
      ],
      "properties": {
        "today": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "counts"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]{4}-[0-9]{2}-[0-9]{2}$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "completedAt"
              ],
              "properties": {
                "completedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                }
              }
            }
          }
        }
      }
    },
    "reminders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morning",
        "evening",
        "calculationMethod",
        "asrSchool",
        "lastShown"
      ],
      "properties": {
        "morning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "evening": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "calculationMethod": {
          "enum": [
            "mwl",
            "umm-al-qura",
            "egyptian",
            "karachi",
            "north-america"
          ]
        },
        "asrSchool": {
          "enum": [
            "standard",
            "hanafi"
          ]
        },
        "lastShown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "morning",
            "evening"
          ],
          "properties": {
            "morning": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "evening": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude",
            "updatedAt"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "updatedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "textSize",
        "lineSpacing",
        "haptics"
      ],
      "properties": {
        "theme": {
          "enum": [
            "system",
            "light",
            "dark"
          ]
        },
        "textSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "lineSpacing": {
          "enum": [
            "compact",
            "comfortable",
            "wide"
          ]
        },
        "haptics": {
          "type": "boolean"
        },
        "longOrder": {
          "enum": [
            "last",
            "original"
          ]
        },
        "longOrderPromptAnswered": {
          "type": "boolean"
        }
      }
    }
  }
}

      "name": "a past day is edited like today",
      "input": {
        "steps": [
          {"command": {"kind": "record"}, "date": "2026-10-20", "prayer": "asr", "scheduledAt": "2026-10-20T11:58:00.000Z"},
          {"command": {"kind": "setTiming", "timing": "made_up"}, "date": "2026-10-20", "prayer": "asr"}
        ]
      },
      "expected": {
        "results": ["changed", "changed"],
        "records": [
          {"date": "2026-10-20", "prayer": "asr", "zone": "Asia/Riyadh", "scheduledAt": "2026-10-20T11:58:00.000Z", "profileVersion": "umm-al-qura/standard/twilight-angle/0,0,0,0,0,0", "state": "prayed", "timing": "made_up", "noon": null, "loggedAt": "2026-10-30T15:00:00.000Z", "updatedAt": "2026-10-30T15:00:00.000Z"}
        ]
      }
    },
    {
      "name": "a record made after midnight stays on the occurrence it names",
      "input": {
        "now": "2026-10-30T21:30:00.000Z",
        "steps": [
          {"command": {"kind": "record"}, "date": "2026-10-30", "prayer": "isha", "scheduledAt": "2026-10-30T15:45:00.000Z"},
          {"command": {"kind": "record"}, "date": "2026-10-31", "prayer": "fajr", "scheduledAt": "2026-10-31T01:46:00.000Z"},
          {"command": {"kind": "record"}, "date": "2026-11-01", "prayer": "fajr"}
        ]
      },
      "expected": {
